    "chai": "^4.3.10",
    "ethers": "^6.9.0",
    "hardhat": "^2.23.0",
    "hardhat-gas-reporter": "^1.0.9",
    "hardhat-contract-sizer": "^2.10.0",
    "solidity-coverage": "^0.8.5",
    "solidity-docgen": "^0.6.0-beta.36",
    "dotenv": "^16.5.0",
